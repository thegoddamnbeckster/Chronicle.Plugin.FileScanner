<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Chronicle.Plugin.FileScanner</AssemblyName>
    <RootNamespace>Chronicle.Plugin.FileScanner</RootNamespace>
    <!-- Plugin DLL must not copy Chronicle.Plugins into its output — it will be
         provided by the host at runtime. Mark the reference as Private=false. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Local path reference during development.
         Replace with NuGet package reference once Chronicle.Plugins is published. -->
    <ProjectReference Include="..\Chronicle\src\Chronicle.Plugins\Chronicle.Plugins.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bare-property form (InternalsVisibleTo as a PropertyGroup child) is not valid MSBuild
         syntax for this and silently did nothing; only tests against this plugin's public API
         had exercised it until now. This is the correct Item-based form. -->
    <InternalsVisibleTo Include="Chronicle.Plugin.FileScanner.Tests" />
  </ItemGroup>

  <!-- Exclude the tests/ subdirectory from the plugin's own compilation -->
  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

  <!-- Copy manifest.json to output directory so PluginHostService can read it -->
  <ItemGroup>
    <None Include="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
